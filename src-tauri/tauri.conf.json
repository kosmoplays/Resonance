{
  "productName": "Resonance",
  "version": "1.0.0",
  "identifier": "com.pablo.resonance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' tauri: http://localhost:1420; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://w.soundcloud.com https://www.youtube.com https://s.ytimg.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http: data:; connect-src 'self' tauri: http: https: ws: wss: data: blob:; frame-src https://w.soundcloud.com https://www.youtube.com https://accounts.google.com;",
      "capabilities": [
        {
          "identifier": "resonance-network-override",
          "windows": [
            "*"
          ],
          "permissions": [
            "http:default",
            {
              "identifier": "http:default",
              "allow": [
                {
                  "url": "http://**"
                },
                {
                  "url": "https://**"
                }
              ]
            }
          ]
        },
        {
          "identifier": "default-window-capability",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:default",
            "core:window:default",
            "core:window:allow-create",
            "core:window:allow-close",
            "core:window:allow-center",
            "core:window:allow-set-focus",
            "core:window:allow-set-size",
            "core:window:allow-set-title",
            "core:window:allow-show",
            "core:webview:default",
            "core:webview:allow-create-webview-window",
            "core:webview:allow-set-webview-focus",
            "core:webview:allow-set-webview-size",
            "core:webview:allow-webview-close",
            "core:webview:allow-webview-show",
            "opener:default"
          ]
        }
      ]
    }
  },
  "plugins": {
    "http": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}